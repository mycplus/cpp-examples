# Run PROG (with up to two arguments ARG and ARG2) and compare its stdout with the
# file EXPECTED, or check that it contains the text CONTAINS. Carriage returns
# are removed first: on Windows, text-mode output writes \r\n line endings.
if(DEFINED ARG2)
  execute_process(COMMAND ${PROG} ${ARG} ${ARG2} OUTPUT_VARIABLE out RESULT_VARIABLE rc ENCODING UTF-8)
elseif(DEFINED ARG)
  execute_process(COMMAND ${PROG} ${ARG} OUTPUT_VARIABLE out RESULT_VARIABLE rc ENCODING UTF-8)
else()
  execute_process(COMMAND ${PROG} OUTPUT_VARIABLE out RESULT_VARIABLE rc ENCODING UTF-8)
endif()
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "${PROG} exited with ${rc}")
endif()
string(REPLACE "\r" "" out "${out}")
if(DEFINED CONTAINS)
  string(FIND "${out}" "${CONTAINS}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "output of ${PROG} does not contain '${CONTAINS}':\n${out}")
  endif()
  return()
endif()
file(READ ${EXPECTED} want)
string(REPLACE "\r" "" want "${want}")
if(NOT out STREQUAL want)
  message(FATAL_ERROR "output of ${PROG} differs from ${EXPECTED}:\n${out}")
endif()
